# Keep the public package limited to reviewed distribution files.
*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/README.zh-CN.md
!/CHANGELOG.md
!/THIRD_PARTY_NOTICES.md
!/plugin.json
!/mcp.json
!/launcher.py
!/setup_connection.py
!/remote_control.py
!/pyproject.toml
!/uv.lock
!/runtime/
!/runtime/*.py
!/runtime/tests/
!/runtime/tests/*.py
!/bridge/
!/bridge/bundle.json
!/bridge/Scripts/
!/bridge/Scripts/**/
!/bridge/Scripts/**/*.md
!/.claude-plugin/
!/.claude-plugin/plugin.json
!/.claude-plugin/marketplace.json
!/skills/
!/skills/obsidian-excalidraw/
!/skills/obsidian-excalidraw/SKILL.md
!/skills/obsidian-excalidraw/references/
!/skills/obsidian-excalidraw/references/diagram-recipes.md
!/skills/obsidian-excalidraw/references/native-features.md

# Never stage runtime configuration, credentials or user output.
.env
.env.*
connection.json
Agent-Bridge-Connection.json
.omp/
.obsidian/
*.excalidraw
*.excalidraw.md
*.excalidrawlib
artifacts/
backups/
__pycache__/
.venv/
*.png
*.log
