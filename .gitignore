# Keep the public package limited to reviewed distribution files.
*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/README.zh-CN.md
!/CHANGELOG.md
!/THIRD_PARTY_NOTICES.md
!/plugin.json
!/mcp.json
!/launcher.py
