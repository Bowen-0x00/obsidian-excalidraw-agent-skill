!/.github/scripts/
!/.github/scripts/*.py
!/scripts/
!/scripts/*.py
!/scripts/*.mjs
!/scripts/tests/
!/scripts/tests/*.py

# Never stage runtime configuration, credentials or user output.
.env
.env.*
connection.json
Agent-Bridge-Connection.json
.omp/
.obsidian/
*.excalidraw
*.excalidraw.md
*.excalidrawlib
artifacts/
backups/
*.metadata-backup
__pycache__/
.venv/
*.png
*.log

# Curated public examples only; arbitrary user canvases/artifacts remain ignored.
!/examples/
!/examples/builders/
!/examples/builders/*.py
!/examples/dsl/
!/examples/dsl/*.yaml
!/examples/dsl/assets/
!/examples/dsl/assets/*.png
!/examples/native/
!/examples/native/*.excalidraw.md
!/examples/native/assets/
!/examples/native/assets/*.png
!/docs/
!/docs/*.md
!/docs/gallery-provenance.json
!/docs/images/
!/docs/images/*.png
